# Copy to .env.local and fill in. Never commit real keys.

# Resend API key (resend.com → API Keys). Required for the Lemonite sign-up.
RESEND_API_KEY=

# Optional: the Resend segment new Lemonites are added to (resend.com → Audience → Segments).
RESEND_SEGMENT_ID=

# Optional: sender for the "New Lemonite signup" email. Must be on a domain verified in Resend.
# Without it, Resend's test sender is used, which can only email your own Resend account address.
# e.g. "Main Squeeze <info@mainsqueezelemonadeco.com>"
RESEND_FROM_EMAIL=

# Optional: who gets the signup notification. Defaults to info@mainsqueezelemonadeco.com.
SIGNUP_NOTIFY_EMAIL=

# --- Ad tracking (all optional; a missing ID switches that platform off) ---
# NEXT_PUBLIC_* values are baked in at build time, so redeploy after changing them.

# Optional: overrides the Meta Pixel ID built into src/lib/track.ts (771944325107338).
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API token (Events Manager → Settings → Conversions API → Generate access token). Secret.
META_CAPI_TOKEN=
# Optional: test code from Events Manager → Test events. Remove once verified.
META_TEST_EVENT_CODE=

# Google Ads tag ID, e.g. AW-1234567890 (Google Ads → Goals → Conversions → Tag setup).
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels: the part after the slash in send_to "AW-1234567890/AbCdEfGh".
NEXT_PUBLIC_GOOGLE_ADS_ORDER_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
